# pktfwd-station-bridge — where to send the gateway's LoRa data.
# This file lives next to the binary. Copy to the gateway and edit ROUTER_ID.

# Gateway identity as registered on the LNS (Browan prefix + MAC for the Femto):
ROUTER_ID=0016C0-80029C4572D3
ROUTER_FORMAT=raw

# Destination A — CUPS bootstrap (leave LNS_URI empty to use this):
CUPS_URI=https://thingparkenterprise.sa.actility.com:443

# Destination B — connect straight to an LNS, skipping CUPS.
# Requires tc.crt/tc.key/tc.trust already present in TC_DIR.
LNS_URI=

# Where the gateway's native lora_pkt_fwd delivers packets:
UDP_LISTEN=127.0.0.1:1700

# Directory holding the tc.* LNS credentials (cached or dropped manually):
TC_DIR=/mnt/data/pktfwd-station-bridge/tc

MODEL=WLRGFM-100
