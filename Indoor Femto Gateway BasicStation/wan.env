# wan.env — WAN / cellular settings for the Indoor Femto Gateway (WLRGFM-100)
# running the pktfwd-station-bridge.
#
# gateway-install.sh reads this file and applies it to /etc/config/network via
# UCI. It is the ONE place to change the carrier — separate from the bridge's
# own .env (which holds the LNS identity, ROUTER_ID).
#
# ⚠ Contains SIM credentials — treat as secret. To avoid committing real creds,
#   drop a copy at /etc/gemtek/wan.env on the device (the installer prefers it).

# Interface protocol: 3g (cellular modem) | dhcp (ethernet WAN)
WAN_PROTO=3g

# Cellular modem device + AT command port
WAN_DEVICE=/dev/ttyUSB0
WAN_AT_PORT=/dev/ttyUSB0

# Carrier APN + SIM (Vivo defaults — replace for your carrier)
WAN_APN=zap.vivo.com.br
WAN_PINCODE=1234
WAN_USERNAME=vivo
WAN_PASSWORD=vivo

# --- Other carriers: replace the four values above with one of these ---
# Claro: WAN_APN=claro.com.br   WAN_USERNAME=claro   WAN_PASSWORD=claro
# TIM:   WAN_APN=timbrasil.br   WAN_USERNAME=tim     WAN_PASSWORD=tim
# Ethernet WAN instead of cellular: set WAN_PROTO=dhcp (device/apn ignored)
